{
  "name": "ri-ri-qing-windows",
  "version": "1.1.0",
  "private": true,
  "description": "日日清 Windows 桌面打卡与提醒应用",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:renderer": "vite build --config vite.config.ts",
    "build:win": "npm run build:renderer && electron-builder --win portable"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "build": {
    "appId": "com.dayclear.ririqing",
    "productName": "日日清",
    "executableName": "RiRiQing",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "dist-renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RiRiQing-${version}-Windows-${arch}.${ext}"
    }
  }
}
